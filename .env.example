# Copiá este archivo como .env.local para desarrollo, y cargá las mismas variables
# en el dashboard de Vercel (Settings > Environment Variables) para producción.
# Nunca compartas estos valores por chat ni los subas a git.

# Resend — API key para el envío de emails
# Se obtiene en https://resend.com/api-keys
RESEND_API_KEY=

# Remitente verificado en Resend (ej: "Fisiotips <consultas@fisiotips.com>").
# Mientras no verifiques el dominio fisiotips.com en Resend, dejá el valor por defecto:
RESEND_FROM=Fisiotips <onboarding@resend.dev>

# Email donde llegan los formularios de evaluación reservada
NOTIFY_EMAIL=jcazenave12@gmail.com

# URL pública del sitio en producción (sin barra final), ej: https://fisiotips.com
SITE_URL=
